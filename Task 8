interface Chargeable {
    void charge();
}

class Vehicle {
    String vehicleNumber;

    Vehicle(String vehicleNumber) {
        this.vehicleNumber = vehicleNumber;
    }

    void display() {
        System.out.println("Vehicle Number: " + vehicleNumber);
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String vehicleNumber) {
        super(vehicleNumber);
    }

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 30");
    }
}

class Car extends Vehicle {
    Car(String vehicleNumber) {
        super(vehicleNumber);
    }

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 90");
    }
}

class ElectricCar extends Vehicle implements Chargeable {
    ElectricCar(String vehicleNumber) {
        super(vehicleNumber);
    }

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 210");
    }

    public void charge() {
        System.out.println("Electric car is connected to the charging station.");
    }
}

public class Main {
    public static void main(String[] args) {
        TwoWheeler bike = new TwoWheeler("TN01AB1234");
        Car car = new Car("TN02CD5678");
        ElectricCar electricCar = new ElectricCar("TN03EF9012");

        System.out.println("----- Two Wheeler Details -----");
        bike.display();
        bike.calculateFee();

        System.out.println();

        System.out.println("----- Car Details -----");
        car.display();
        car.calculateFee();

        System.out.println();

        System.out.println("----- Electric Car Details -----");
        electricCar.display();
        electricCar.calculateFee();
        electricCar.charge();
    }
}
