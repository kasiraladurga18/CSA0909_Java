public class Main {
    public static void main(String[] args) {
        String[] slots = {"Empty", "Occupied", "Empty", "Occupied", "Empty"};
        String vehicle = "Car";
        boolean allocated = false;

        System.out.println("CAMPUS SMART PARKING SYSTEM");
        System.out.println("---------------------------");
        System.out.println("Vehicle Type: " + vehicle);
        System.out.println("\nParking Slots Before Allocation:");

        for (int i = 0; i < slots.length; i++) {
            System.out.println("Slot " + (i + 1) + ": " + slots[i]);
        }

        for (int i = 0; i < slots.length; i++) {
            if (slots[i].equals("Empty")) {
                slots[i] = vehicle;
                System.out.println("\nVehicle allocated to Slot " + (i + 1));
                allocated = true;
                break;
            }
        }

        if (!allocated) {
            System.out.println("\nNo parking slot available");
        }

        System.out.println("\nParking Slots After Allocation:");

        for (int i = 0; i < slots.length; i++) {
            System.out.println("Slot " + (i + 1) + ": " + slots[i]);
        }

        System.out.println("\nAllocation Status: " +
                (allocated ? "Successful" : "Failed"));
    }
}
