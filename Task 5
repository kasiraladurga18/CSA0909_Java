public class Main {
    public static void main(String[] args) {
        String[] slots = {
            "Occupied", "Empty", "Empty",
            "Occupied", "Empty", "Occupied"
        };

        int available = 0;
        int occupied = 0;

        System.out.println("CAMPUS SMART PARKING SYSTEM");
        System.out.println("---------------------------");
        System.out.println("\nParking Slot Details:");

        for (int i = 0; i < slots.length; i++) {
            System.out.println("Slot " + (i + 1) + ": " + slots[i]);

            if (slots[i].equals("Empty")) {
                available++;
            } else {
                occupied++;
            }
        }

        System.out.println("\nTotal Parking Slots: " + slots.length);
        System.out.println("Available Slots: " + available);
        System.out.println("Occupied Slots: " + occupied);

        System.out.println("\nParking Status: " +
                (available > 0 ? "Slots Available" : "Parking Full"));
    }
}
