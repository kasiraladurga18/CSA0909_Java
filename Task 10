abstract class Vehicle {
    String vehicleNumber;
    String vehicleType;

    Vehicle(String vehicleNumber, String vehicleType) {
        this.vehicleNumber = vehicleNumber;
        this.vehicleType = vehicleType;
    }

    abstract void calculateFee();

    void displayDetails() {
        System.out.println("Vehicle Number: " + vehicleNumber);
        System.out.println("Vehicle Type: " + vehicleType);
    }
}

class Car extends Vehicle {
    Car(String vehicleNumber) {
        super(vehicleNumber, "Car");
    }

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 90");
    }
}

class Bike extends Vehicle {
    Bike(String vehicleNumber) {
        super(vehicleNumber, "Bike");
    }

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 30");
    }
}

class ElectricCar extends Vehicle {
    ElectricCar(String vehicleNumber) {
        super(vehicleNumber, "Electric Car");
    }

    void calculateFee() {
        System.out.println("Parking Fee: Rs. 210");
    }
}

public class Main {
    public static void main(String[] args) {
        Vehicle v1 = new Car("TN01AB1234");
        Vehicle v2 = new Bike("TN02CD5678");
        Vehicle v3 = new ElectricCar("TN03EF9012");

        System.out.println("----- Car Details -----");
        v1.displayDetails();
        v1.calculateFee();

        System.out.println();

        System.out.println("----- Bike Details -----");
        v2.displayDetails();
        v2.calculateFee();

        System.out.println();

        System.out.println("----- Electric Car Details -----");
        v3.displayDetails();
        v3.calculateFee();
    }
}
